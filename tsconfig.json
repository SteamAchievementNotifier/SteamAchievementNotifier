{
    "compilerOptions": {
        "target": "es2020",
        "module": "commonjs",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "rootDir": "./src",
        "rootDirs": [
            "./src/app",
            "./src/notify",
            "./src/lang"
        ],
        "outDir": "./dist",
        "paths": {
            "@xan105/vdf/binary": ["./node_modules/@xan105/vdf/types/binary.d.ts"]
        }
    },
    "include": ["./src/**/*.ts"],
    "exclude": ["./node_modules"]
}
